# Public project settings only. These are bundled into the browser at build time.
NEXT_PUBLIC_SUPABASE_URL=https://ednddqfwazggfsdaklwp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY are also supported.

# Public Monad Testnet settings. RPC and explorer defaults are built in.
MONAD_TESTNET_ESCROW_ADDRESS=
MONAD_TESTNET_DEPLOYMENT_BLOCK=
# MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# MONAD_TESTNET_EXPLORER_URL=https://testnet.monadscan.com

# Server only. Never use NEXT_PUBLIC_ names for these; do not commit real values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
APP_ORIGIN=https://YOUR_EXACT_VERCEL_PREVIEW_OR_PRODUCTION_ORIGIN
CRON_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Local development: APP_ORIGIN=http://127.0.0.1:4173

# Deployment only. Set privately for one command; never commit or expose it to Vercel.
# MONAD_DEPLOYER_PRIVATE_KEY=0xYOUR_FUNDED_TESTNET_PRIVATE_KEY
